{
  "name": "raiffy",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "convex:dev": "convex dev",
    "rag:build-import": "tsx scripts/build-rag-import.ts",
    "rag:eval": "tsx scripts/eval-retrieval.ts",
    "agent:build-setup": "tsx scripts/build-agent-setup.ts",
    "agent:check-setup": "tsx scripts/build-agent-setup.ts --check",
    "agent:eval-routing": "tsx scripts/eval-routing.ts",
    "advice:eval": "tsx scripts/eval-advice.ts",
    "memory:check-mcp": "tsx scripts/check-memory-mcp.ts",
    "convex:typecheck": "tsc --noEmit -p convex/tsconfig.json",
    "catalog:build-import": "tsx scripts/build-catalog-import.ts",
    "catalog:build-products": "tsx scripts/build-products-import.ts",
    "voice:setup": "python3 tools/voice/setup.py",
    "voice:garrett": "python3 tools/voice/garrett.py",
    "voice:check-browser": "node tools/voice/check-phonon-browser.mjs",
    "voice:check-reply": "node tools/voice/check-phonon-browser.mjs --voice-reply",
    "voice:check-hands-free": "node tools/voice/check-phonon-browser.mjs --hands-free",
    "voice:transcribe": "python3 tools/voice/local.py transcribe",
    "voice:speak": "python3 tools/voice/local.py speak",
    "voice:smoke": "python3 tools/voice/local.py smoke",
    "voice:test": "python3 -m unittest discover -s tools/voice -p 'test_*.py'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@convex-dev/resend": "^0.2.10",
    "convex": "^1.48.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "convex-test": "^0.0.65",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
