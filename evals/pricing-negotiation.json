    "expect": { "resolution": "not_needed" } },
  { "id": "PRICE-04", "title": "competitor about 120 lei cheaper in total: automatic counter-offer inside the band (fee waiver)",
    "persona": "cheaper-competitor", "competitor": "sample-bank-b-loan", "switches": { "account": true, "savings": true },
    "expect": { "resolution": "band", "levers": ["feeWaiver"] } },
  { "id": "PRICE-05", "title": "mortgage refinance beyond the band: escalated to a specialist, no offer",
